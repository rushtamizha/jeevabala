# ─────────────────────────────────────────────────────────────────────────────
#  Saarathi Cabs – environment configuration
#  Copy to .env.local (development) or set in your hosting provider (production).
#  Generate secrets with:  npm run secrets:generate
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/saarathi
# Set DB_SSL=true for managed databases (Neon, Supabase, RDS…)
DB_SSL=false
DB_POOL_MAX=10

# Absolute public URL of the site (used for links in notifications and CSRF checks)
APP_URL=http://localhost:3000
# Optional: extra allowed origins (comma separated), e.g. https://www.example.com
ALLOWED_ORIGINS=

# 32+ random chars – HMAC key for OTPs, signed places, etc.
APP_SECRET=
# 64 hex chars (32 bytes) – AES-256-GCM key for secrets stored in the database
ENCRYPTION_KEY=

# Number of reverse proxies in front of the app that append X-Forwarded-For (Nginx=1, none=0)
TRUSTED_PROXY_HOPS=1
# Set true only if the site is behind Cloudflare (uses CF-Connecting-IP)
TRUST_CLOUDFLARE=false

# Bearer secret for /api/cron (retries failed notifications, cleans up expired data)
CRON_SECRET=

# ── Maps ─────────────────────────────────────────────────────────────────────
# With a Google Maps Platform key (Places API (New) + Routes API + Geocoding API)
# you get the best Indian address search. Without it, OpenStreetMap (Photon + OSRM) is used.
GOOGLE_MAPS_API_KEY=
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org

# ── Bot protection (optional, Cloudflare Turnstile) ──────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Integrations ─────────────────────────────────────────────────────────────
# Everything below can instead be configured in Admin → Settings → Integrations
# (stored encrypted). Values set here take precedence.

# Telegram bot (create with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp: meta | twilio | callmebot
WHATSAPP_PROVIDER=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_TEMPLATE=
WHATSAPP_META_TEMPLATE_LANG=en
WHATSAPP_META_API_VERSION=v23.0
WHATSAPP_TWILIO_SID=
WHATSAPP_TWILIO_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_CALLMEBOT_APIKEY=

# Email (SMTP) – required in production for customer verification codes.
# Gmail: smtp.gmail.com / 465 / SMTP_SECURE=true with an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=
